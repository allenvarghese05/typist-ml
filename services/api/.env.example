# Optional overrides for services/api settings (typist.config.Settings). Copy this file to
# services/api/.env (gitignored) or export the variables. Every variable is optional.
#
# Database file. A relative path is resolved against the repository root, never the working
# directory, so the default stays inside the gitignored data/ directory.
# TYPIST_DB_PATH=data/typist.db
#
# Address the API serves on. `just dev` passes 127.0.0.1:8000 to uvicorn directly.
# TYPIST_HOST=127.0.0.1
# TYPIST_PORT=8000
